#!/usr/bin/env bash
# cargo-tog-rustc — public RUSTC_WRAPPER name for cargo-tog.
# Maps CARGO_TOG_* env into the compiler-cache engine, then execs it.
set -euo pipefail

# Local disk location (our name)
if [ -n "${CARGO_TOG_CACHE_DIR:-}" ]; then
  export SCCACHE_DIR="${CARGO_TOG_CACHE_DIR}"
fi

# Remote object store (our names → engine env)
if [ -n "${CARGO_TOG_BUCKET:-}" ]; then
  export SCCACHE_BUCKET="${CARGO_TOG_BUCKET}"
fi
if [ -n "${CARGO_TOG_ENDPOINT:-}" ]; then
  export SCCACHE_ENDPOINT="${CARGO_TOG_ENDPOINT}"
fi
if [ -n "${CARGO_TOG_REGION:-}" ]; then
  export SCCACHE_REGION="${CARGO_TOG_REGION}"
elif [ -n "${CARGO_TOG_BUCKET:-}" ] && [ -z "${SCCACHE_REGION:-}" ]; then
  export SCCACHE_REGION=auto
fi
if [ -n "${CARGO_TOG_ACCESS_KEY_ID:-}" ]; then
  export AWS_ACCESS_KEY_ID="${CARGO_TOG_ACCESS_KEY_ID}"
fi
if [ -n "${CARGO_TOG_SECRET_ACCESS_KEY:-}" ]; then
  export AWS_SECRET_ACCESS_KEY="${CARGO_TOG_SECRET_ACCESS_KEY}"
fi

if command -v sccache >/dev/null 2>&1; then
  exec sccache "$@"
fi

# Fallback: no engine installed — compile without cache rather than hard-fail.
exec "${RUSTC:-rustc}" "$@"
