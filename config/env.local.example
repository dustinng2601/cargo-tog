# Laptop defaults — source from shell profile or direnv.

# One download cache for every clone on this machine
# export CARGO_HOME="$HOME/.cargo"

# Compiler cache
export RUSTC_WRAPPER=sccache
export SCCACHE_DIR="${SCCACHE_DIR:-$HOME/.cache/sccache}"

# Optional: same remote store as CI (S3/R2)
# export SCCACHE_BUCKET=my-sccache
# export SCCACHE_ENDPOINT=https://....r2.cloudflarestorage.com
# export SCCACHE_REGION=auto
# export AWS_ACCESS_KEY_ID=...
# export AWS_SECRET_ACCESS_KEY=...

# Do NOT export one CARGO_TARGET_DIR for all projects.
# Per checkout only if you want a custom path:
# export CARGO_TARGET_DIR="$PWD/target"
