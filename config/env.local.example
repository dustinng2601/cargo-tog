# cargo-tog local env — our names only

# Preferred: install the native binaries, which land on PATH via ~/.cargo/bin.
#   cargo install --path .
export RUSTC_WRAPPER=cargo-tog-rustc

# Fallback for a checkout you have not installed yet: put scripts/ on PATH.
# The shim prefers the native binary and never re-enters itself.
# export PATH="/path/to/cargo-tog/scripts:$PATH"

# Mode: local is the default off GitHub Actions. See docs/MODES.md.
# export CARGO_TOG_MODE=local

# Object cache directory. Leave unset to use the platform default:
#   macOS   ~/Library/Caches/cargo-tog
#   Linux   ${XDG_CACHE_HOME:-~/.cache}/cargo-tog
#   Windows %LOCALAPPDATA%\cargo-tog
# export CARGO_TOG_CACHE_DIR="$HOME/.cache/cargo-tog"

# Optional remote object cache (S3-compatible). Only mode=remote reads these.
# export CARGO_TOG_BUCKET=my-cargo-tog-cache
# export CARGO_TOG_ENDPOINT=https://....r2.cloudflarestorage.com
# export CARGO_TOG_REGION=auto
# export CARGO_TOG_ACCESS_KEY_ID=...
# export CARGO_TOG_SECRET_ACCESS_KEY=...

# Do NOT set one CARGO_TARGET_DIR for every project.
