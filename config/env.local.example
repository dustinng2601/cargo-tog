# Source from shell profile or direnv — laptop defaults for cargo-tog orgs.

# One download cache for all clones
# export CARGO_HOME="$HOME/.cargo"

# Compiler cache (install sccache first)
export RUSTC_WRAPPER=sccache
export SCCACHE_DIR="${SCCACHE_DIR:-$HOME/.cache/sccache}"

# Optional: quieter / smaller local dev objects
# export CARGO_PROFILE_DEV_DEBUG=0

# Do NOT export a global CARGO_TARGET_DIR for all projects.
# Per checkout only, e.g. in monorepo .envrc:
# export CARGO_TARGET_DIR="$PWD/target"
