# cargo-tog local env — our names only

export PATH="/path/to/cargo-tog/scripts:$PATH"
export RUSTC_WRAPPER=cargo-tog-rustc
export CARGO_TOG_CACHE_DIR="${CARGO_TOG_CACHE_DIR:-$HOME/.cache/cargo-tog}"

# Optional remote object cache (S3-compatible)
# export CARGO_TOG_BUCKET=my-cargo-tog-cache
# export CARGO_TOG_ENDPOINT=https://....r2.cloudflarestorage.com
# export CARGO_TOG_REGION=auto
# export CARGO_TOG_ACCESS_KEY_ID=...
# export CARGO_TOG_SECRET_ACCESS_KEY=...

# Do NOT set one CARGO_TARGET_DIR for every project.
